# Copy to .env and fill in to enable each optional food source. Both keys
# are only ever read server-side by server/index.js — never bundled into
# the client. Without either set, the app works fine with the personal
# library (and Open Food Facts, which needs no key — see below).

# Nutritionix: free dev tier, 500 calls/day — https://www.nutritionix.com/business/api
NUTRITIONIX_APP_ID=
NUTRITIONIX_API_KEY=

# USDA FoodData Central: free key — https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=

# Open Food Facts needs no API key and is called directly from the browser
# (its read API is public/CORS-open) — nothing to configure here.

# Port for the proxy/static server (npm run server / npm start)
PORT=8787

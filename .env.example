# Copy to .env and fill in to enable the Nutritionix food source.
# Sign up (free dev tier, 500 calls/day) at https://www.nutritionix.com/business/api
# The key is only ever read server-side by server/index.js — it is never
# bundled into the client.
NUTRITIONIX_APP_ID=
NUTRITIONIX_API_KEY=

# Port for the proxy/static server (npm run server / npm start)
PORT=8787
